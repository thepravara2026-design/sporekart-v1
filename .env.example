# SPOREKART v3.0 Production Environment Variables Template
# Copy to .env and populate with production values. Do NOT commit real secrets!

# Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_VERSION=3.0.0-RELEASE

# Database Credentials
DATABASE_URL=jdbc:postgresql://localhost:5432/sporekart_prod
DATABASE_USERNAME=sporekart_user
DATABASE_PASSWORD=CHANGE_ME_PRODUCTION_STRONG_PASSWORD

# Security & CORS
CORS_ALLOWED_ORIGINS=https://sporekart.example.com
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET_KEY

# Payment Provider Integration
PAYMENT_PROVIDER_KEY=pk_live_mock_key
PAYMENT_PROVIDER_SECRET=sk_live_mock_secret
PAYMENT_WEBHOOK_SECRET=whsec_live_mock_secret
